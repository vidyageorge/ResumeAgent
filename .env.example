# Vidya Copilot Configuration

# Server
HOST=127.0.0.1
PORT=8000
API_KEY=change-me-to-a-strong-local-key

# Ollama (local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Workspace — projects the copilot can read/write
WORKSPACE_ROOT=c:\Users\vidya.g\Documents\GitHub

# Data directories (auto-created)
DATA_DIR=./data
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/vidya_copilot.db

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=8

# Agent
MAX_TOOL_ITERATIONS=10
COMMAND_TIMEOUT_SECONDS=120

# User profile (used in system prompts)
USER_NAME=Vidya
USER_ROLE=QA Automation Engineer
